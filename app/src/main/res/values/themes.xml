<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlassLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:layoutDirection">ltr</item>
        <item name="android:windowBackground">@color/base_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackground">@color/base_bg</item>
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorAccent">@color/blob_cyan</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- App-wide default face; individual styles override with heavier Inter weights. -->
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>
</resources>
