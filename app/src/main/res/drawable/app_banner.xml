<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1C1F26"
                android:centerColor="#2A2E3A"
                android:endColor="#14151A" />
        </shape>
    </item>
    <item android:width="56dp" android:height="56dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#2E33BBFF" />
            <stroke android:width="2dp" android:color="#80BBFFFF" />
        </shape>
    </item>
</layer-list>
